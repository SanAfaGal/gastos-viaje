# Copia este archivo como .env y ajusta lo que necesites. El .env no se sube a git.
# `npm run dev` lo lee solo.

# --- Local (tu computador) ---
# Archivo de la base SQLite. Si no lo pones, usa ./data/gastos.db
DB_FILE=./data/gastos.db
# Puerto del servidor local.
PORT=3000
# 127.0.0.1 = solo tu PC. 0.0.0.0 = también otros dispositivos de tu wifi (celular).
HOST=127.0.0.1

# Código del administrador (solo gestiona espacios, no ve datos). Sin él no hay administración. En línea (Netlify)
# ponlo siempre, largo y aleatorio (openssl rand -base64 24) y distinto de APP_PASSCODE.
ADMIN_PASSCODE=
# Solo siembra el código de Principal la primera vez que alguien entra con él (después se puede borrar). Si no pones
# ninguna de las dos, la app queda abierta y sin administración (lo normal en local).
APP_PASSCODE=

# --- En línea (Netlify + Turso) ---
# Estas dos se configuran en Netlify (Project configuration, Environment variables), no aquí.
# Si las pones en tu .env local, la app local usaría la base de producción.
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=
